generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GUEST
  KONTRIBUTOR
  MODERATOR
  ADMIN
}

enum ExamType {
  UTS
  UAS
}

enum ModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum QuestionType {
  PILIHAN_GANDA
  ESAI_TERSTRUKTUR
  STUDI_KASUS
  HITUNGAN
}

enum Difficulty {
  MUDAH
  SEDANG
  SULIT
}

enum ActivityType {
  SOAL_DIKERJAKAN
  SOAL_DISIMPAN
  RATING_KESULITAN
  PENILAIAN_PEMBAHASAN
}

enum StorageUploadKind {
  EXAM_DOCUMENT
  ANSWER_KEY
}

enum StorageProvider {
  S3
  LOCAL
}

enum StorageUploadStatus {
  RESERVED
  UPLOADED
  ATTACHED
  REJECTED
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  passwordHash     String
  role             UserRole      @default(KONTRIBUTOR)
  departmentId     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  department       Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  contributedPapers ExamPaper[]  @relation("Kontributor")
  moderatedPapers  ExamPaper[]   @relation("Moderator")
  activities       UserActivity[]
  sessions         Session[]
  recoveryTokens   RecoveryToken[]
  uploads          StorageUpload[]
  comments         DiscussionComment[]
  paperViews       PaperView[]

  @@index([departmentId, role])
}

model Faculty {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  examPapers  ExamPaper[]

  @@index([name])
  @@index([deletedAt])
}

model Department {
  id          String      @id @default(cuid())
  name        String
  facultyId   String
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  faculty     Faculty     @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  courses     Course[]
  users       User[]
  examPapers  ExamPaper[]

  @@unique([facultyId, name])
  @@index([facultyId, name])
  @@index([deletedAt])
}

model Course {
  id             String        @id @default(cuid())
  name           String
  code           String        @unique
  departmentId   String
  semester       Int
  professorName  String?
  description    String?
  deletedAt      DateTime?
  department     Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  topics         RpsTopic[]
  examPapers     ExamPaper[]
  examSchedules  ExamSchedule[]

  @@index([departmentId, semester])
  @@index([departmentId, name, deletedAt])
  @@index([deletedAt])
  @@index([name])
  @@index([professorName])
}

model RpsTopic {
  id        String     @id @default(cuid())
  courseId  String
  name      String
  chapter   String?
  order     Int        @default(0)
  deletedAt DateTime?
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  questions Question[]

  @@unique([courseId, name])
  @@index([courseId, order])
  @@index([courseId, name, deletedAt])
}

model ExamPaper {
  id              String           @id @default(cuid())
  facultyId       String
  departmentId    String
  courseId        String
  contributorId   String
  moderatorId     String?
  examYear        Int
  examType        ExamType
  topicName       String
  pdfUrl          String?
  answerUrl       String?
  sourceName      String?
  distributionConfirmedAt DateTime?
  status          ModerationStatus @default(PENDING)
  moderatorNote   String?
  submittedAt     DateTime         @default(now())
  moderatedAt     DateTime?
  faculty         Faculty          @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  contributor     User             @relation("Kontributor", fields: [contributorId], references: [id], onDelete: Restrict)
  moderator       User?            @relation("Moderator", fields: [moderatorId], references: [id], onDelete: SetNull)
  questions       Question[]
  uploads         StorageUpload[]
  comments        DiscussionComment[]
  views           PaperView[]

  @@index([courseId, examYear, examType])
  @@index([status, submittedAt])
  @@index([contributorId])
}

model Question {
  id             String        @id @default(cuid())
  paperId        String
  topicId        String?
  type           QuestionType
  prompt         String
  mediaUrl       String?
  subQuestions   Json?
  answerKey      String?
  explanation    String?
  difficulty     Difficulty?
  sequence       Int           @default(0)
  createdAt      DateTime      @default(now())
  paper          ExamPaper     @relation(fields: [paperId], references: [id], onDelete: Restrict)
  topic          RpsTopic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  activities     UserActivity[]

  @@index([paperId, sequence])
  @@index([topicId, difficulty])
  @@index([type])
}

model UserActivity {
  id             String       @id @default(cuid())
  userId         String
  questionId     String
  type           ActivityType
  isCorrect      Boolean?
  difficultyRate Int?
  vote           Int?
  durationSec    Int?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([questionId, type])
}

model Session {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  csrfTokenHash   String
  userId          String?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model RecoveryToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model StorageUpload {
  id           String             @id @default(cuid())
  ownerId      String
  paperId      String?
  objectKey    String             @unique
  storageProvider StorageProvider @default(S3)
  originalName String
  contentType  String
  sizeBytes    Int
  kind         StorageUploadKind
  status       StorageUploadStatus @default(RESERVED)
  expiresAt    DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  paper        ExamPaper?         @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([ownerId, status, expiresAt])
  @@index([paperId, status])
}

model ExamSchedule {
  id       String   @id @default(cuid())
  courseId String
  title    String
  startsAt DateTime
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([startsAt, courseId])
}

model DiscussionComment {
  id         String    @id @default(cuid())
  paperId    String
  userId     String
  content    String    @db.VarChar(3000)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  paper      ExamPaper @relation(fields: [paperId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([paperId, createdAt])
  @@index([userId, createdAt])
}

model PaperView {
  id           String    @id @default(cuid())
  paperId      String
  userId       String?
  visitorKey   String
  viewedAt     DateTime  @default(now())
  viewCount    Int       @default(1)
  paper         ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([paperId, visitorKey])
  @@index([paperId, viewedAt])
  @@index([userId, viewedAt])
}

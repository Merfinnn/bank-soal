FROM node:22-bookworm-slim AS build

WORKDIR /app
ENV API_INTERNAL_BASE_URL=http://backend:3001
ENV NEXT_PUBLIC_API_BASE_URL=/api
ENV DATABASE_URL=postgresql://siap_ujian:build-only@localhost:5432/siap_ujian?schema=public

RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx prisma generate && npm run build

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV API_INTERNAL_BASE_URL=http://backend:3001
ENV NEXT_PUBLIC_API_BASE_URL=/api

COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/.next ./.next
COPY --from=build --chown=node:node /app/next.config.ts ./next.config.ts
COPY --from=build --chown=node:node /app/app ./app
COPY --from=build --chown=node:node /app/components ./components
COPY --from=build --chown=node:node /app/styles.css ./styles.css
COPY --from=build --chown=node:node /app/tsconfig.json ./tsconfig.json
COPY --from=build --chown=node:node /app/postcss.config.mjs ./postcss.config.mjs

USER node
EXPOSE 3000

CMD ["npm", "run", "start", "--", "-H", "0.0.0.0"]

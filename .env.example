# PostgreSQL localhost URL untuk Prisma CLI yang dijalankan langsung dari host.
# Di dalam Docker Compose, backend memakai host layanan "db" secara otomatis.
POSTGRES_DB=siap_ujian
POSTGRES_USER=siap_ujian
POSTGRES_PASSWORD=siap_ujian_local_password
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://siap_ujian:siap_ujian_local_password@localhost:5433/siap_ujian?schema=public

# Origin UI yang dibuka di peramban; diperlukan untuk validasi CSRF.
APP_ORIGIN=http://localhost:3000
DOCKER_APP_ORIGIN=http://localhost:3000

# Next.js meneruskan /api ke NestJS melalui alamat internal jaringan Docker.
API_INTERNAL_BASE_URL=http://backend:3001
NEXT_PUBLIC_API_BASE_URL=/api

# Mode development mengaktifkan fallback penyimpanan lokal ketika S3 belum disetel.
NODE_ENV=development
PORT=3001
AWS_REGION=ap-southeast-3
AWS_S3_BUCKET=

# Opsional: konfigurasi email untuk fitur pemulihan akun.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Siap Ujian <noreply@localhost>

# Hanya dibaca oleh seeder admin lokal; jangan gunakan kata sandi contoh ini di produksi.
ADMIN_SEED_PASSWORD=adminpassword
